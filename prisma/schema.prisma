// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String?
  name          String?
  image         String?
  phone         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Relations
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  cart          CartItem[]
  
  @@index([email])
}

// Address Model
model Address {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type          String     // "home", "work", "billing", "shipping"
  street        String
  city          String
  state         String
  postalCode    String
  country       String
  phone         String
  isDefault     Boolean    @default(false)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([userId])
}

// Product/Saree Model
model Saree {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  description   String     @db.Text
  longDescription String?   @db.Text
  
  category      String     // "Kanchipuram", "Banarasi", "Bridal", "Designer", "PartyWear", "Traditional"
  subcategory   String?
  
  price         Decimal    @db.Decimal(10, 2)
  salePrice     Decimal?   @db.Decimal(10, 2)
  cost          Decimal    @db.Decimal(10, 2)
  
  sku           String     @unique
  stock         Int        @default(0)
  reserved      Int        @default(0)
  
  color         String
  pattern       String?
  material      String     // "Silk", "Cotton", "Blend", etc.
  weight        String?
  length        String?
  
  rating        Float      @default(0)
  reviewCount   Int        @default(0)
  
  images        String[]   // Array of image URLs from Cloudinary
  thumbnail     String?
  
  isFeatured    Boolean    @default(false)
  isNew         Boolean    @default(true)
  isAvailable   Boolean    @default(true)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Relations
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlists     Wishlist[]
  
  @@index([category])
  @@index([slug])
}

// Cart Model
model CartItem {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sareeId       String
  saree         Saree      @relation(fields: [sareeId], references: [id], onDelete: Cascade)
  
  quantity      Int        @default(1)
  addedAt       DateTime   @default(now())
  
  @@unique([userId, sareeId])
  @@index([userId])
  @@index([sareeId])
}

// Wishlist Model
model Wishlist {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sareeId       String
  saree         Saree      @relation(fields: [sareeId], references: [id], onDelete: Cascade)
  
  addedAt       DateTime   @default(now())
  
  @@unique([userId, sareeId])
  @@index([userId])
  @@index([sareeId])
}

// Order Model
model Order {
  id            String     @id @default(cuid())
  orderNumber   String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  
  status        String     @default("pending") // "pending", "confirmed", "shipped", "delivered", "cancelled"
  paymentStatus String     @default("pending") // "pending", "paid", "failed", "refunded"
  paymentMethod String?    // "razorpay", "upi", "card", "netbanking"
  
  shippingAddressId String?
  billingAddressId  String?
  
  subtotal      Decimal    @db.Decimal(10, 2)
  tax           Decimal    @db.Decimal(10, 2) @default(0)
  shipping      Decimal    @db.Decimal(10, 2) @default(0)
  discount      Decimal    @db.Decimal(10, 2) @default(0)
  total         Decimal    @db.Decimal(10, 2)
  
  notes         String?    @db.Text
  trackingNumber String?
  
  razorpayOrderId String?
  razorpayPaymentId String?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deliveredAt   DateTime?
  
  // Relations
  items         OrderItem[]
  
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// Order Item Model
model OrderItem {
  id            String     @id @default(cuid())
  orderId       String
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  sareeId       String
  saree         Saree      @relation(fields: [sareeId], references: [id])
  
  quantity      Int
  price         Decimal    @db.Decimal(10, 2)
  
  @@index([orderId])
  @@index([sareeId])
}

// Review Model
model Review {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sareeId       String
  saree         Saree      @relation(fields: [sareeId], references: [id], onDelete: Cascade)
  
  rating        Int        // 1-5
  title         String
  content       String     @db.Text
  images        String[]   // Customer photos
  
  verified      Boolean    @default(false)
  helpful       Int        @default(0)
  unhelpful     Int        @default(0)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@unique([userId, sareeId])
  @@index([sareeId])
  @@index([userId])
}

// Category Model
model Category {
  id            String     @id @default(cuid())
  name          String     @unique
  slug          String     @unique
  description   String?    @db.Text
  image         String?
  order         Int        @default(0)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// Blog Post Model
model BlogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String
  content       String     @db.Text
  image         String?
  author        String
  
  published     Boolean    @default(false)
  featured      Boolean    @default(false)
  
  views         Int        @default(0)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedAt   DateTime?
}
